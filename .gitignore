 ############################
 # Project / Build Folders
 ############################
 target/
 build/
 out/

 # Allow module-specific build folders if needed
 !**/src/main/**/target/
 !**/src/test/**/target/
 !**/src/main/**/build/
 !**/src/test/**/build/

 ############################
 # Maven Wrapper
 ############################
 .mvn/wrapper/maven-wrapper.jar

 ############################
 # Logs
 ############################
 *.log
 logs/

 ############################
 # OS Files
 ############################
 .DS_Store
 Thumbs.db

 ############################
 # IDEs
 ############################
 # IntelliJ IDEA
 .idea/
 *.iws
 *.iml
 *.ipr

 # Eclipse / STS
 .apt_generated
 .classpath
 .factorypath
 .project
 .settings
 .springBeans
 .sts4-cache

 # NetBeans
 /nbproject/private/
 /nbbuild/
 /dist/
 /nbdist/
 /.nb-gradle/

 # VS Code
 .vscode/

 ############################
 # Environment / Secrets
 ############################
 .env
 .env.*
 application-local.yml
 application-local.properties

 ############################
 # Node / React (if frontend)
 ############################
 node_modules/
 dist/
 npm-debug.log*
 yarn-debug.log*
 yarn-error.log*

 ############################
 # Test / Coverage
 ############################
 coverage/
 *.exec
